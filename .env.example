# Bitcoin Core v31.0
BITCOIN_RPC_URL=http://127.0.0.1:8332
BITCOIN_COOKIE_PATH=/home/YOUR_UBUNTU_USER/.bitcoin/.cookie

# LND
LIGHTNING_IMPLEMENTATION=lnd
LIGHTNING_RPC_URL=https://127.0.0.1:8080
LIGHTNING_MACAROON=/home/YOUR_UBUNTU_USER/.lnd/data/chain/bitcoin/mainnet/admin.macaroon
LIGHTNING_CERT_PATH=/home/YOUR_UBUNTU_USER/.lnd/tls.cert
ALLOW_INSECURE_TLS=true

